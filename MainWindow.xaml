<Window x:Class="ClaudeCodeExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClaudeCodeExplorer.Converters"
        xmlns:models="clr-namespace:ClaudeCodeExplorer.Models"
        Title="Claude Code Explorer"
        Height="720" Width="1040"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/claude.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:RelativeTimeConverter x:Key="RelTime"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>
        <conv:PathLeafConverter x:Key="PathLeaf"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Search box -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Background" Value="{DynamicResource SearchBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Refresh button -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6"
                                Background="{DynamicResource ToolButtonBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolButtonHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Conversation card -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="10"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource CardBackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource CardBackgroundPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card close (delete) button -->
        <Style x:Key="CardCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-4,-4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="ToolTip" Value="Delete this conversation"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" CornerRadius="11" Background="Transparent">
                            <TextBlock Text="&#x2715;" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One tile per conversation -->
        <DataTemplate x:Key="ConversationCardTemplate" DataType="{x:Type models:ConversationInfo}">
            <Button Style="{StaticResource CardButtonStyle}"
                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    ToolTip="{Binding FirstUserMessage}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Resume this conversation"
                                  Command="{Binding PlacementTarget.Tag.ResumeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Open terminal here (no resume)"
                                  Command="{Binding PlacementTarget.Tag.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Open folder in Explorer"
                                  Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Copy session id"
                                  Command="{Binding PlacementTarget.Tag.CopyIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Delete conversation"
                                  Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Button.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ProjectName}" Margin="0,0,24,0"
                               Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Delete (X) button, top-right corner -->
                    <Button Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource CardCloseButtonStyle}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>

                    <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,6,0,0"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top"/>

                    <Grid Grid.Row="2">
                        <TextBlock HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding LastActivityUtc, Converter={StaticResource RelTime}}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding MessageCount, StringFormat='{}{0} msgs'}"/>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Claude Code Explorer"
                           VerticalAlignment="Center" Margin="2,0,18,0"
                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>

                <!-- Search box with watermark -->
                <Grid Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left" Width="420">
                    <TextBox Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"/>
                    <TextBlock Text="Search conversations, projects, prompts…"
                               Foreground="{DynamicResource WatermarkText}" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}"/>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                           VerticalAlignment="Center" Margin="18,0,12,0"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12"/>

                <Button Grid.Column="3" Content="Refresh" Style="{StaticResource ToolButtonStyle}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- Tile grid – grouped by project folder, each project in an Expander -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="8" Focusable="False">
            <ItemsControl ItemsSource="{Binding ConversationsView}"
                          ItemTemplate="{StaticResource ConversationCardTemplate}">
                <!-- Outer panel: vertical stack of group expanders -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <!-- Each group rendered as an Expander -->
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Margin="0,4,0,10"
                                                      Background="Transparent" BorderThickness="0"
                                                      Foreground="{DynamicResource TextPrimary}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource PathLeaf}}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" Margin="12,0,0,0"
                                                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"
                                                                   MaxWidth="560"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"/>
                                                        <Border CornerRadius="9" Padding="8,1" Margin="12,0,0,0"
                                                                Background="{DynamicResource ToolButtonBackground}"
                                                                BorderBrush="{DynamicResource ControlBorder}"
                                                                BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       Text="{Binding ItemCount}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter Margin="0,4,0,4"/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <!-- Inside each group: the tiles wrap -->
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading overlay -->
        <Border Grid.Row="1" Background="{DynamicResource OverlayBackground}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
