<Window x:Class="ClaudeCodeExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClaudeCodeExplorer.Converters"
        xmlns:models="clr-namespace:ClaudeCodeExplorer.Models"
        xmlns:beh="clr-namespace:ClaudeCodeExplorer.Behaviors"
        Title="Claude Code Explorer"
        Height="720" Width="1040"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/claude.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:RelativeTimeConverter x:Key="RelTime"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>
        <conv:PathLeafConverter x:Key="PathLeaf"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:ConfigSourceToBrushConverter x:Key="SourceBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Config inspector: one row per merged setting / array element / file / branch -->
        <HierarchicalDataTemplate DataType="{x:Type models:ConfigNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent"
                        ToolTip="{Binding OverrideTooltip}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"
                        beh:ClickToCommand.Command="{Binding DataContext.OpenConfigFileCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                        beh:ClickToCommand.CommandParameter="{Binding}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanOpen}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"
                        Background="{Binding EffectiveSource, Converter={StaticResource SourceBrush}}"
                        Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SourceLabel}" FontSize="9" Foreground="White"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text=" = " VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                           Visibility="{Binding ShowValue, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding DisplayValue}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                <TextBlock Text="  ⓘ overridden" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}"
                           Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}"/>
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open file / folder"
                                  Command="{Binding PlacementTarget.Tag.OpenConfigFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Copy value"
                                  Command="{Binding PlacementTarget.Tag.CopyValueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Search box -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Background" Value="{DynamicResource SearchBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Refresh button -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6"
                                Background="{DynamicResource ToolButtonBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolButtonHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact tool button for the bottom status bar -->
        <Style x:Key="StatusButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- Tiny up/down button inside the day spinner -->
        <Style x:Key="SpinnerRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="sb" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sb" Property="Background" Value="{DynamicResource ToolButtonHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sb" Property="Background" Value="{DynamicResource ToolButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Conversation card -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="10"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource CardBackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource CardBackgroundPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card close (delete) button -->
        <Style x:Key="CardCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-4,-4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="ToolTip" Value="Delete this conversation"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" CornerRadius="11" Background="Transparent">
                            <TextBlock Text="&#x2715;" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Batch-selection checkbox on each tile -->
        <Style x:Key="TileCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Select for batch delete"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                                Background="{DynamicResource SearchBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="check" Text="&#x2713;" FontSize="12" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Select all" button in a folder group header -->
        <Style x:Key="GroupActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="gb" CornerRadius="9"
                                Background="{DynamicResource ToolButtonBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="gb" Property="Background" Value="{DynamicResource ToolButtonHover}"/>
                                <Setter TargetName="gb" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One tile per conversation -->
        <DataTemplate x:Key="ConversationCardTemplate" DataType="{x:Type models:ConversationInfo}">
            <Button Style="{StaticResource CardButtonStyle}"
                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    ToolTip="{Binding FirstUserMessage}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Resume this conversation"
                                  Command="{Binding PlacementTarget.Tag.ResumeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Open terminal here (no resume)"
                                  Command="{Binding PlacementTarget.Tag.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Open folder in Explorer"
                                  Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Copy session id"
                                  Command="{Binding PlacementTarget.Tag.CopyIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Delete conversation"
                                  Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Button.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- MinHeight reserves room for the checkbox / delete button even when the
                             accent heading is empty (auto-named sessions), so the body clears them. -->
                        <RowDefinition Height="Auto" MinHeight="18"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selection checkbox, top-left corner -->
                    <CheckBox Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource TileCheckBoxStyle}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="0" Text="{Binding DisplayName}" Margin="24,0,24,0"
                               Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Delete (X) button, top-right corner -->
                    <Button Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource CardCloseButtonStyle}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>

                    <TextBlock Grid.Row="1" Text="{Binding PreviewText}" Margin="0,6,0,0"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top"/>

                    <Grid Grid.Row="2">
                        <TextBlock HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding LastActivityUtc, Converter={StaticResource RelTime}}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding MessageCount, StringFormat='{}{0} msgs'}"/>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: search only -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Claude Code Explorer"
                           VerticalAlignment="Center" Margin="2,0,18,0"
                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>

                <!-- Search box with watermark -->
                <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                    <TextBox Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"/>
                    <TextBlock Text="Search conversations, projects, prompts…"
                               Foreground="{DynamicResource WatermarkText}" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 1: split into tiles (left) | splitter | config inspector (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding InspectorColumnWidth, Mode=TwoWay}"/>
            </Grid.ColumnDefinitions>

            <!-- Left: tiles + loading overlay -->
            <Grid Grid.Column="0">
        <!-- Tile grid – grouped by project folder, each project in an Expander -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="8" Focusable="False">
            <ItemsControl ItemsSource="{Binding ConversationsView}"
                          ItemTemplate="{StaticResource ConversationCardTemplate}">
                <!-- Outer panel: vertical stack of group expanders -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <!-- Each group rendered as an Expander -->
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Margin="0,4,0,10"
                                                      Background="Transparent" BorderThickness="0"
                                                      Foreground="{DynamicResource TextPrimary}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource PathLeaf}}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" Margin="12,0,0,0"
                                                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"
                                                                   MaxWidth="560"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"/>
                                                        <Border CornerRadius="9" Padding="8,1" Margin="12,0,0,0"
                                                                Background="{DynamicResource ToolButtonBackground}"
                                                                BorderBrush="{DynamicResource ControlBorder}"
                                                                BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       Text="{Binding ItemCount}"/>
                                                        </Border>
                                                        <Button Content="Select all" Style="{StaticResource GroupActionButtonStyle}"
                                                                ToolTip="Select or clear every conversation in this folder"
                                                                Command="{Binding DataContext.SelectAllInGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Inspect settings" Style="{StaticResource GroupActionButtonStyle}"
                                                                ToolTip="Show the effective Claude config for this folder"
                                                                Command="{Binding DataContext.InspectSettingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <Expander.Tag>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </Expander.Tag>
                                                <Expander.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Inspect settings (split view)"
                                                                  Command="{Binding PlacementTarget.Tag.InspectSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Expander.ContextMenu>
                                                <ItemsPresenter Margin="0,4,0,4"/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <!-- Inside each group: the tiles wrap -->
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </ItemsControl>
        </ScrollViewer>

                <!-- Loading overlay (covers the tiles column) -->
                <Border Background="{DynamicResource OverlayBackground}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </Grid>

            <!-- Resizable divider (only while the inspector is open) -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource Border}" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVis}}"/>

            <!-- Right: config inspector (devtools-style). The column width is bound TwoWay, so the
                 splitter resizes it and closing sets it to 0 — making the panel disappear entirely. -->
            <Border Grid.Column="2"
                    Background="{DynamicResource WindowBackground}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource TopBarBackground}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Claude config (effective)" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding InspectorTitle}" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding InspectorTitle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource StatusButtonStyle}"
                                    VerticalAlignment="Top" ToolTip="Close inspector"
                                    Command="{Binding CloseInspectorCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Source legend (low → high precedence) -->
                    <Border DockPanel.Dock="Top" Padding="10,5" Background="{DynamicResource TopBarBackground}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="3" Padding="4,0" Margin="0,0,6,0" Background="#8F8880"><TextBlock Text="user" FontSize="9" Foreground="White"/></Border>
                            <Border CornerRadius="3" Padding="4,0" Margin="0,0,6,0" Background="#4A9EE0"><TextBlock Text="project" FontSize="9" Foreground="White"/></Border>
                            <Border CornerRadius="3" Padding="4,0" Margin="0,0,6,0" Background="#5FB37A"><TextBlock Text="local" FontSize="9" Foreground="White"/></Border>
                            <Border CornerRadius="3" Padding="4,0" Background="#E0673F"><TextBlock Text="managed" FontSize="9" Foreground="White"/></Border>
                        </StackPanel>
                    </Border>

                    <TreeView ItemsSource="{Binding InspectorNodes}" Background="Transparent"
                              BorderThickness="0" Foreground="{DynamicResource TextPrimary}"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Docked bottom status bar: status + full-text toggle + all actions + index progress -->
        <Border Grid.Row="2" Background="{DynamicResource TopBarBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status text + full-text search toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <CheckBox Content="Full-text search" Margin="18,0,0,0" VerticalAlignment="Center"
                              FontSize="12" Foreground="{DynamicResource TextSecondary}"
                              ToolTip="Also search inside the whole conversation text (uses the local index)"
                              IsChecked="{Binding UseFullTextSearch, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Right: index progress + all action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IndexingText}" Margin="0,0,8,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Width="140" Height="6" Margin="0,0,12,0"
                                 Minimum="0" Maximum="100" Value="{Binding IndexingProgress, Mode=OneWay}"
                                 Background="{DynamicResource SearchBackground}"
                                 BorderThickness="0" Foreground="{DynamicResource Accent}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVis}}"/>

                    <!-- Day spinner (retention threshold for "Delete older") -->
                    <Border CornerRadius="6" Height="26" Margin="6,0,0,0"
                            Background="{DynamicResource SearchBackground}"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="38" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     ToolTip="Age threshold in days (minimum 1)"
                                     Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Vertical" Width="14">
                                <RepeatButton Height="12" Content="▲" Style="{StaticResource SpinnerRepeatButtonStyle}"
                                              Command="{Binding IncrementDaysCommand}"/>
                                <RepeatButton Height="12" Content="▼" Style="{StaticResource SpinnerRepeatButtonStyle}"
                                              Command="{Binding DecrementDaysCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="days" VerticalAlignment="Center" Margin="6,0,0,0"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}"/>

                    <Button Content="Delete older" Style="{StaticResource StatusButtonStyle}"
                            ToolTip="Delete all conversations older than the chosen number of days"
                            Command="{Binding DeleteOlderCommand}"/>
                    <Button Content="Delete empty" Style="{StaticResource StatusButtonStyle}"
                            ToolTip="Delete all conversations that have no messages"
                            Command="{Binding DeleteEmptyCommand}"/>

                    <Border Width="1" Margin="10,3" Background="{DynamicResource ControlBorder}"/>

                    <Button Content="Delete selected" Style="{StaticResource StatusButtonStyle}"
                            ToolTip="Delete every checked conversation (across all folders)"
                            IsEnabled="{Binding HasSelection}"
                            Command="{Binding DeleteSelectedCommand}"/>
                    <Button Content="Clear selection" Style="{StaticResource StatusButtonStyle}"
                            ToolTip="Uncheck all selected conversations"
                            Command="{Binding ClearSelectionCommand}"/>

                    <Border Width="1" Margin="10,3" Background="{DynamicResource ControlBorder}"/>

                    <Button Content="Rebuild index" Style="{StaticResource StatusButtonStyle}"
                            ToolTip="Delete and rebuild the full-text search index from scratch"
                            IsEnabled="{Binding IsIndexing, Converter={StaticResource InverseBool}}"
                            Command="{Binding RebuildIndexCommand}"/>
                    <Button Content="Refresh" Style="{StaticResource StatusButtonStyle}"
                            ToolTip="Rescan ~/.claude/projects"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
