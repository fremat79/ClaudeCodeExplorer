<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground"      Color="#F5F2EE"/>
    <SolidColorBrush x:Key="TopBarBackground"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border"                Color="#E5E2DD"/>
    <SolidColorBrush x:Key="ControlBorder"         Color="#D9D4CC"/>

    <SolidColorBrush x:Key="CardBackground"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundHover"   Color="#FFFDFB"/>
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="#F3EDE7"/>
    <SolidColorBrush x:Key="CardBorder"            Color="#E5E2DD"/>

    <SolidColorBrush x:Key="Accent"                Color="#D97757"/>

    <SolidColorBrush x:Key="TextPrimary"           Color="#2B2926"/>
    <SolidColorBrush x:Key="TextSecondary"         Color="#6B6660"/>
    <SolidColorBrush x:Key="TextMuted"             Color="#8A847B"/>
    <SolidColorBrush x:Key="WatermarkText"         Color="#9B958C"/>

    <SolidColorBrush x:Key="SearchBackground"      Color="#FBFAF8"/>
    <SolidColorBrush x:Key="ToolButtonBackground"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolButtonHover"       Color="#F0ECE6"/>
    <SolidColorBrush x:Key="ToolButtonPressed"     Color="#E7E0D8"/>

    <SolidColorBrush x:Key="OverlayBackground"     Color="#C0F5F2EE"/>

</ResourceDictionary>
